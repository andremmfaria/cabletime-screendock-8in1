#!/bin/sh
# Reloads systemd and udev after removal; purge also deletes the screendock user, group and logs.
set -e

case "$1" in
remove | purge)
    if [ -d /run/systemd/system ]; then
        systemctl daemon-reload || true
        udevadm control --reload || true
    fi
    ;;
esac

case "$1" in
purge)
    rm -rf /var/log/screendock
    if getent passwd screendock >/dev/null; then
        userdel screendock || true
    fi
    if getent group screendock >/dev/null; then
        groupdel screendock || true
    fi
    ;;
esac

exit 0
